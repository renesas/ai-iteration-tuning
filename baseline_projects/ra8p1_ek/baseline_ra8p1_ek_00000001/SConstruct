    def __init__(self, filename, xml_root):
        super().__init__(filename)
        self.type = 'tz_ns'

        # Extend common_project type
        extend_tree = etree.parse(self._xml_file)
        extend_root = extend_tree.getroot()
        parse_project(extend_root, self)
        parse_project(xml_root, self)


class project_secondary_core(project_common):

    def __init__(self, filename, xml_root):
        #Init base-data
        project_common.__init__(self, filename)
        self.type = 'secondary_core'

        # Extend common_project type for secondary core
        secondary_core_tree = etree.parse(CONST_COMMON_SECONDARY_CORE_PROJECT_FILE)
        secondary_core_root = secondary_core_tree.getroot()
        parse_project(secondary_core_root, self)
        parse_project(xml_root, self)

        # Update mcu_dict to use secondary cores
        for mcu in CONST_MCU_DICT:
            if "secondary_core" in CONST_MCU_DICT[mcu]:
                self.mcu_dict[mcu] = CONST_MCU_DICT[mcu]["secondary_core"]

class project_primary_core(project_common):

    def __init__(self, filename, xml_root):
        #Init base-data
        project_common.__init__(self, filename)
        self.type = 'primary_core'

        # Extend common_project type for primary core
        primary_core_tree = etree.parse(CONST_COMMON_PRIMARY_CORE_PROJECT_FILE)
        primary_core_root = primary_core_tree.getroot()
        parse_project(primary_core_root, self)
        parse_project(xml_root, self)

# Define toolchain class to store all variables related to toolchain
class toolchain(object):
    __slots__ = ['name',
                 'cc_name',
                 'cc_com',
                 'cpp_com',
                 'clang_tidy_com',
                 'common_flags',
                 'cxx_flags',
                 'c_flags',
                 'cpp_flags',
                 'fsp_flags',
                 'third_party_flags',
                 'extra_flags',
                 'cmse_flags',
                 'cmse_link_flags',
                 'iar_lib_link_flags',
                 'fpu_flags',
                 'fpu_link_flags',
                 'debug_flags',
                 'as_name',
                 'as_com',
                 'as_flags',
                 'link_name',
                 'link_com',
                 'link_flags',
                 'link_ext',
                 'link_script_prefix',
                 'lib_prefix',
                 'lib_dir_prefix',
                 'lib_inc_prefix',
                 'lib_inc_suffix',
                 'ar_name',
                 'ar_com',
                 'optimization_levels']

    def __init__(self, toolchain_info):
            get_tc_info = lambda item : toolchain_info[item] if toolchain_info[item] is not None else [] # Safe 'get' for tags that don't always have elements
            self.name = toolchain_info['name']

            self.cc_name = toolchain_info['cc_name']
            self.cc_com = toolchain_info['cc_com']
            self.cpp_com = toolchain_info['cpp_com']
            self.clang_tidy_com = ''
            if 'gcc' == self.name:
                self.clang_tidy_com = toolchain_info['clang_tidy_com']
                if 'fix' == static_analyze:
                    self.clang_tidy_com = self.clang_tidy_com.replace('$FIX_OPTION', '-fix')
                else:
                    self.clang_tidy_com = self.clang_tidy_com.replace('$FIX_OPTION', '-export-fixes=${TARGET}.fix')
                self.clang_tidy_com += " -Itest_files/clang_headers"
            self.as_name = toolchain_info['as_name']
            self.as_com = toolchain_info['as_com']
            self.link_name = toolchain_info['link_name']
            self.link_com = toolchain_info['link_com']
            self.link_ext = toolchain_info['link_ext']
            self.lib_prefix = toolchain_info['lib_prefix']
            self.lib_dir_prefix = toolchain_info['lib_dir_prefix']
            self.lib_inc_prefix = toolchain_info['lib_inc_prefix']
            self.lib_inc_suffix = toolchain_info['lib_inc_suffix']
            self.link_script_prefix = toolchain_info['link_script_prefix']
            self.ar_name = toolchain_info['ar_name']
            self.ar_com = toolchain_info['ar_com']

            self.common_flags = get_tc_info('common_flags') # Parse flags common to compiler and linker
            self.cxx_flags = toolchain_info['cxx_flags'] # Parse flags common to c and cpp
            self.c_flags = toolchain_info['c_flags'] # Parse C flags
            self.cpp_flags = toolchain_info['cpp_flags'] # Parse CPP flags
            self.fsp_flags = toolchain_info['fsp_flags'] # Parse FSP flags

            self.third_party_flags = toolchain_info['third_party_flags'] # Parse CC flags for third party code

            version_env = create_env()
            # OR with true so this will not fail build jobs if toolchains are not defined in tools_cfg_ref.xml
            version_env.Command(self.name + '.version', None, self.cc_name + ' --version > ' + self.name + '.version || true')

            self.extra_flags = get_tc_info('extra_flags') # Parse Extra flags
            self.debug_flags = toolchain_info['debug_flags'] # Parse Debug flags
            self.cmse_flags = toolchain_info['cmse_flags'] # Parse CMSE flags
            self.cmse_link_flags = toolchain_info['cmse_link_flags'] # Parse CMSE flags
            # if 'iar' == self.name:
                # self.iar_lib_link_flags = toolchain_info['iar_lib_link_flags'] # Parse link flags required for IAR threading support
            self.fpu_flags = toolchain_info['fpu_flags'] # Parse FPU flags
            self.fpu_link_flags = get_tc_info('fpu_link_flags') # Parse FPU link flags
            self.as_flags = toolchain_info['as_flags'] # Parse assembler flags
            self.link_flags = toolchain_info['link_flags'] # Parse Linker flags
            self.optimization_levels = toolchain_info['optimization_levels'] # Parse optimization levels

