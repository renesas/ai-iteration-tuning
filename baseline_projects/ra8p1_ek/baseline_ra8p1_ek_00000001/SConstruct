# Common file names and locations
CONST_PROJECT_XML_DIR = 'env_cfg'
CONST_COMMON_PROJECT_FILE = 'env_cfg/common.xml'
CONST_COMMON_TZ_S_PROJECT_FILE = 'env_cfg/common_tz_s.xml'
CONST_COMMON_TZ_NS_PROJECT_FILE = 'env_cfg/common_tz_ns.xml'

CONST_COMMON_PRIMARY_CORE_PROJECT_FILE = 'env_cfg/common_primary_core.xml'
CONST_COMMON_SECONDARY_CORE_PROJECT_FILE = 'env_cfg/common_secondary_core.xml'

CONST_COMMON_TOOLS_FILE = 'env_cfg/tools.yml'
CONST_TOOLS_CFG_FILE_NAME = 'env_cfg/tools_cfg.xml'
CONST_TOOLS_CFG_REF_FILE_NAME = 'env_cfg/tools_cfg_ref.xml'
CONST_MCU_CFG_FILE = 'env_cfg/mcu_cfg.yml'

# Define the core and default optimization level build(s) for each part.
with open(CONST_MCU_CFG_FILE, 'r') as f:
    CONST_MCU_DICT = yaml.load(f, Loader=yaml.Loader)

# Lookups for the features of the different cores.
CONST_CORE_FPU_DICT = { '23':None,
                        '33':'5',
                        '4' :'4',
                        '85':'5' }
CONST_CORE_CMSE_DICT = { '23':False,
                         '33':True,
                         '4' :False,
                         '85':True }
CONST_CORE_ARM_ARCH_DICT = { '23':'__ARM_ARCH_8M_BASE__',
                             '33':'__ARM_ARCH_8M_MAIN__',
                             '4' :'__ARM_ARCH_7EM__',
                             '85':'__ARM_ARCH_8_1M_MAIN__' }
CONST_CORE_ARM_ARCH_FLAGS_DICT = { '23':'',
                                   '33':'',
                                   '4' :'',
                                   '85' :''}
CONST_CORE_ARM_GCC_85_HACKS_DICT = { 'primary_core' : '33' }
CONST_EXTRA_WARNINGS = True
CONST_GCOV_MIN_HEAP_SIZE = 0x1000
CONST_GCOV_MIN_STACK_SIZE = 0xD00

# Global Variables
g_dependent_projects = []
g_project_list = []
g_scons_cache_dir = ''
GetOption: any
# Set number of CPUs to enable parallel build
num_cpus = multiprocessing.cpu_count()
# Run with one more job than cores.
#  - Though not entirely scientific, in my testing this seems to yeild about a 5-10% speed improvement, more did not seem to be better though.
SetOption('num_jobs', num_cpus+1)
print("running with -j " + str(GetOption('num_jobs')))

# This function is borrowed from 'scripts/utility.py'
def find_project_xml_files(module):
    module = module.lower()
    project_list = []
    if not os.path.exists(module):
        for path, dirs, filenames in os.walk(CONST_PROJECT_XML_DIR):
            for dir_iter in dirs:
                if module == dir_iter.lower():
                    project_dir = os.path.join(path, dir_iter)
                    if os.path.exists(project_dir):
                        module = project_dir
                        break
            if not os.path.exists(module):
                for filename in filenames:
                    if filename.lower() == module + '.xml' or filename.lower() == module:
                        module = os.path.join(path, filename)
                        break
    if not os.path.exists(module):
        return []
    if os.path.isdir(module):
        for path, _, filenames in os.walk(module):
            for filename in filenames:
                project_file = os.path.abspath(path + '/' + filename)
                project_list.append(project_file)
    else:
        project_file = os.path.abspath(module)
        project_list.append(project_file)

    return project_list

# Define build class to store all variables related to build
class build_obj(object):
    def __init__(self, tools_def_yml):
        self.toolchains = []
        self.projects = {} # Includes build variants
        self.build_stack = []
        self.project_files = [] # List of files processed
        self.target_groups = {}

        # Get toolchain configurations
        self._parse_toolchains(tools_def_yml, self.toolchains)

    def _add_project(self, filename, xml_root):
        if xml_root.tag == "projects":
            for new_root in xml_root.findall("project"):
                self._add_project(filename, new_root)
            return

        type = xml_root.find("type")

        # Add projects according to type
        #  - Default to 'flat' project type
        if type is None or type.text == 'flat':
            type_str='flat'
            new_proj = project_common(filename, xml_root)
        elif type.text == 'tz_s':
            type_str='tz_s'
            new_proj = project_tz_secure(filename, xml_root)
        elif type.text == 'tz_s_only':
            type_str='tz_s_only'
            new_proj = project_tz_secure(filename, xml_root)
            new_proj.type = type_str
        elif type.text == 'tz_ns':
            type_str='tz_ns'
            new_proj = project_tz_nonsecure(filename, xml_root)
        elif type.text == 'secondary_core':
            type_str='secondary_core'
            new_proj = project_secondary_core(filename, xml_root)
        elif type.text == 'primary_core':
            type_str='primary_core'
            new_proj = project_primary_core(filename, xml_root)
        else:
            # Unknown build type
            assert()

        # Get unique but deterministic name for this build, so we can reference it later
        hash_gen = hashlib.sha256()
        xml_items = [str(e.text) if e is not None else '' for e in xml_root.iter()]
        str_cat = ''.join(xml_items).encode()
        hash_gen.update(str_cat)
        build_key = new_proj.module_name+"_"+type_str+"_"+str(hash_gen.hexdigest())

        # Add project and dependencies if we haven't already
        # Use stack to keep track of required build order.
        if build_key not in self.build_stack:
            self.projects[build_key] = new_proj
            self.build_stack.append(build_key)

            for p in new_proj.dependencies:
                g_dependent_projects.append(p)
                self.add_project(p)

    def add_project(self, project):
        # @proj_name can be a directory or project name
        # e.g. a value of 'projects' will build all project xmls contained in the 'projects' folder

        # Find build xml, reduce to xmls that haven't been processed yet
        project_files = find_project_xml_files(project)
        project_files = [e for e in project_files if e.endswith('.xml')]
        project_files = [e for e in project_files if not any(filter(lambda x: e.endswith(f'{x}.xml'), GetOption('exclude_projects')))]
        project_files = [e for e in project_files if e not in self.project_files]

        # Mark files processed early to short-circuit recursion
        self.project_files = self.project_files + project_files

        # Add all projects defined in the xml
        for file in project_files:
            tree = etree.parse(file)
            root = tree.getroot()
            self._add_project(file, root)

    def do_builds(self):
        arg_toolchain = GetOption('compiler')
        print("tool chain:",arg_toolchain)
        arg_project = GetOption('project')
        print("Project: ",arg_project)
        # Build all projects that have already been added
        # NOTE: Stack used to manage order
        while self.build_stack:
            build_key = self.build_stack.pop()
            project = self.projects[build_key]

            # Skip processing for non-libraries if --only_libs is specified
            if CONST_ONLY_LIBS and not (project.create_lib or project.build_module_source_only):
                continue

            # Filter boards, toolchains
            arg_board = GetOption('board')
            print("Board: ",arg_board)
            arg_board_list = arg_board.replace("\"", "").rstrip(" ").split(" ") if arg_board else []
            boards = []
            for e in project.boards:
                if (0 == len(arg_board_list)) or any(board_token in e for board_token in arg_board_list):
                    boards.append(e)
            if not boards:
                continue

            toolchains = [e for e in self.toolchains if not arg_toolchain or e.name == arg_toolchain]
            toolchains = [e for e in toolchains if e.name not in project.skip_compiler]

            if arg_project and arg_project != project.name and project.module_name not in g_dependent_projects:
                continue

            dbg_info_toolchains = [e.name for e in toolchains]
            dbg_info_boards = ["Source Only"] if not boards else boards
            dbg_info_name = project.name if project.name else 'debug'
            dbg_info_num_builds = len(dbg_info_toolchains) * len(dbg_info_boards)
            print("\r\n" + 125*"=" + "\r\n" +\
                  f"Project: {project.module_name} {project.type} {dbg_info_name} - {dbg_info_num_builds} builds \r\n" +\
                  f" - {dbg_info_toolchains}\r\n" +\
                  f" - {dbg_info_boards} \r\n" +\
                  125*"=")
            for toolchain in toolchains:
                # Don't build TrustZone projects with gcov
                if 'tz' in project.type and CONST_USE_GCOV and toolchain.name == 'gcc':
                    continue
                for board in boards:
                    mcu = board.split('_')[0].lower()
                    for o_level in CONST_MCU_DICT[mcu]['o_levels']:
                        self._do_build(o_level, project, toolchain, board)

        # Create test info
        for key in self.target_groups:
            with open(os.path.join(key, 'test_info.yml'), 'w') as f:
                f.write(yaml.dump(self.target_groups[key]))

    # build - Build object
    # project - XML file that holds 'root'
    # toolchain - toolchain to use for build
    # board - target
    def _do_build(self, o_level, project, toolchain, board):
        current_mcu = mcu = board.split('_')[0].lower()

        list_of_common_files = []
        list_of_libs = []
        list_of_main_files = []
        list_of_test_files = []
        list_of_third_party_test_files = []
        for dir, exclude_boards in (project.common_dirs + project.test_dirs + project.main_dirs + project.third_party_test_dirs):
            # Skip excluded boards
            if exclude_boards is not None:
                if board in exclude_boards:
                    continue

            filepaths = []
            if os.path.isfile(dir):
                temp_path, temp_name = os.path.split(dir)
                filepaths.append((temp_path, [temp_name]))
            else:
                for (dirpath, _, filenames) in os.walk(dir):
                    filepaths.append((dirpath, filenames))

            for (dirpath, filenames) in filepaths:
                rel_path = os.path.relpath(dirpath, dir)
                for filename in filenames:
                    filepath = os.path.normpath(os.path.join(dirpath, filename))
                    skip = False
                    # Skip files that are in an exclude path
                    if any(exclude in filepath for exclude in project.exclude_dirs):
                        skip = True
                    if not (filepath.endswith('.cc') or filepath.endswith('.cpp') or filepath.endswith('.c.template') or filepath.endswith('.c') or filepath.endswith('.s') or filepath.endswith('.S') or filepath.endswith('.a')):
                        skip = True
                    if '!' in rel_path:
                        skip = True

                    # Exclude files for other MCUs
                    for mcu in project.mcu_dict:
                        # Don't skip code for other MCUs in test code
                        if '!' not in os.path.relpath(filepath):
                            if os.path.sep + mcu.lower() + os.path.sep in filepath.lower():
                                if mcu.lower() != current_mcu:
                                    skip = True
                        cm_core = 'cm' + project.mcu_dict[mcu]
                        if cm_core in filepath.lower():
                            if project.mcu_dict[mcu] != project.mcu_dict[current_mcu]:
                                skip = True

                    # Exclude files for other compilers
                    for compiler in self.compiler_list:
                        if compiler.lower() in filepath.lower():
                            if compiler.lower() != toolchain.name.lower():
                                skip = True
                    # Exclude files for other boards
                    # Don't skip code for other boards in test code
                    # don't skip for directory named custom in wifi_drivers
                    if '!' not in filepath and 'wifi_driver' not in filepath:
                        for board_iter in os.listdir('ra/board'):
                            if board_iter.lower() in filepath.lower() and board_iter != 'custom':
                                if board_iter.lower() != board:
                                    skip = True

                    if skip:
                        continue

                    if filepath.endswith('.a'):
                        list_of_libs.append(filepath)

                    # Add file to build if it's a source file or template AND we're building an example project
                    is_template = filepath.endswith('.c.template') and os.path.relpath(filepath).startswith('ra/fsp/')
                    is_example = project.build_module_source_only
                    is_source = filepath.endswith('.c') or filepath.endswith('cpp') or filepath.endswith('cc')
                    if is_source or (is_template and is_example):
                        def first(x):
                            return x[0]
                        if dir in list(map(first, project.main_dirs)):
                            list_of_main_files.append(filepath)
                        if dir in list(map(first, project.third_party_test_dirs)):
                            list_of_third_party_test_files.append(filepath)
                        if dir in list(map(first, project.test_dirs)):
                            list_of_test_files.append(filepath)
                        if dir in list(map(first, project.common_dirs)):
                            list_of_common_files.append(filepath)

        # remove duplicate files (can happen if source dirs overlap)
        list_of_main_files   = list(set(list_of_main_files))
        list_of_test_files   = list(set(list_of_test_files))
        list_of_common_files = list(set(list_of_common_files))
        list_of_third_party_test_files   = list(set(list_of_third_party_test_files))

        # remove source files that are in multiple src groups
        list_of_no_instrument_files      = project.no_instrument_files
        list_of_third_party_test_files   = list(filter(lambda x: x not in list_of_no_instrument_files, list_of_third_party_test_files))
        list_of_main_files   = list(filter(lambda x: x not in list_of_no_instrument_files and x not in list_of_third_party_test_files, list_of_main_files))
        list_of_test_files   = list(filter(lambda x: x not in list_of_no_instrument_files and x not in list_of_main_files and x not in list_of_third_party_test_files, list_of_test_files))
        list_of_common_files = list(filter(lambda x: x not in list_of_no_instrument_files and x not in list_of_test_files and x not in list_of_main_files and x not in list_of_third_party_test_files, list_of_common_files))

        # Ensure no module files are in the test files group
        assert( not any(project.module_name+'.c' in e for e in list_of_test_files)) # Module files should not be listed in '<test_dir>' section of project XML

        # helper function to create common env used for the current project
        def create_common_env(third_party=False, optimization_level=o_level):
            env = create_env()
            configure_project_environment(env, project)
            configure_build_environment(env, optimization_level, toolchain, project, board.upper())
            configure_tool_environment(env, toolchain, current_mcu, project, third_party)
            configure_build_rules(env)
            return env

        # create env for building common source files
        common_env = create_common_env()

       # use_gcov = CONST_USE_GCOV and toolchain.name == 'gcc'

        project_name = project.module_name
        if project.name:
            project_name += '_' + project.name

        for key in project.main_macro_configurations:
            build_config_name = project_name
            if key:
                build_config_name = project_name + '_' + key

            # output_file = 'build_' + build_config_name + '_debug'
            # output_dir = os.path.join('build', project.module_name, board, toolchain.name, output_file)
            # output_file_path = os.path.join(output_dir, output_file)
            # output_elf_file = output_file_path + '.elf'

            # Force a single output: .\build\baseline_ra8p1_ek_00000001.elf
            output_basename = 'baseline_ra8p1_ek_00000001'
            output_dir = os.path.join('build')                  # .\build
            if not os.path.exists(output_dir):
                os.makedirs(output_dir)
            output_file = output_basename                       # used by SCons Program target below
            output_file_path = os.path.join(output_dir, output_basename)  # .\build\baseline_ra8p1_ek_00000001 (no ext)
            output_elf_file = output_file_path + '.elf'         # .\build\baseline_ra8p1_ek_00000001.elf

            if GetOption('build_config') and GetOption('build_config') != build_config_name and project.module_name not in g_dependent_projects:
                continue

            if not os.path.exists(output_dir):
                os.makedirs(output_dir)

            # Skip builds not in the global build directory
            if global_build_dir:
                if 'build' in global_build_dir and global_build_dir not in os.path.relpath(output_dir):
                    continue

            # Used to hold info for testing
            build_info = {}

            # Add dependencies to build description
            secure_import_lib = ''
            secure_import_elf = ''
            build_info['dependencies'] = []
            # Certain project info gets saved to file, except for Trust Zone secure projects
            for dependency in project.dependencies:
                if 'tz_ns' == project.type:
                    # Find all secure object files for this build
                    secure_import_lib = 'build/' + dependency + '/' + board + '/' + toolchain.name + '/build_' + dependency + '_' + key + '_debug' + '/build_' + dependency + '_' + key + '_debug.elf.o'
                    secure_import_elf = secure_import_lib[:-len('.o')]
                    # See if this is AC6 and we need to include the SREC file instead
                    secure_srec = secure_import_lib[:-len('.elf.o')] + '.srec'
                    build_info['dependencies'].append(secure_srec)
                elif 'FSP_BOOTLOADER_PROJECT' in project.test_macros:
                    # Only typical build supported for boot apps
                    boot_app = 'build/' + dependency + '/' + board + '/' + toolchain.name + '/build_' + dependency + '_typical_debug' + '/build_' + dependency + '_typical_debug.bin'
                    boot_app_signed = boot_app.replace('.bin', '.signed.srec')
                    build_info['dependencies'].append(boot_app_signed)

                    if 'FSP_BOOTLOADER_DOWNLOADER' not in project.test_macros:
                        secondary_app = 'build/' + dependency + '/' + board + '/' + toolchain.name + '/build_' + dependency + '_secondary_debug' + '/build_' + dependency + '_secondary_debug.bin'
                        secondary_app_signed = secondary_app.replace('.bin', '.signed.srec')
                        build_info['dependencies'].append(secondary_app_signed)
                        build_info['rtt_address_elf'] = secondary_app.replace('.bin', '.elf')
                    else:
                        build_info['rtt_address_elf'] = boot_app.replace('.bin', '.elf')

            # create env for building main source files
            main_env = create_common_env()
            main_env['CPPDEFINES'].update(project.test_macros)
            main_env['CPPDEFINES'].update(project.main_macro_configurations[key])
            main_env['COMMON_FLAGS'] = copy.deepcopy(main_env['COMMON_FLAGS']) + toolchain.extra_flags

            # create env for building test test files
            test_file_optimization_level = 'typical' if o_level == 'size' else o_level
            test_env = create_common_env(optimization_level=test_file_optimization_level)
            test_env['CPPDEFINES'].update(project.test_macros)
            test_env['CPPDEFINES'].update(project.main_macro_configurations[key])

            # No optimize environment - no coverage
            no_instrument_env = create_common_env()
            no_instrument_env['CPPDEFINES'].update(project.test_macros)
            no_instrument_env['CPPDEFINES'].update(project.main_macro_configurations[key])

            # Don't build tests for TX_ENABLE_IAR_LIBRARY_SUPPORT for GCC or AC6
            # create env for building third party source files
            third_party_test_env = create_common_env(third_party=True)
            third_party_test_env['CPPDEFINES'].update(project.test_macros)
            third_party_test_env['CPPDEFINES'].update(project.main_macro_configurations[key])

            if static_analyze is not None and toolchain.clang_tidy_com and not project.ignore_warnings:
                    # The following loop is a hack and likely can be removed when clang-tidy is updated to version 12 or greater
                    # NOTE: When this is removed, we'll need to add '--assume-filename' to the clang command for it to see the
                    # 'template' file as a 'c' file.
                    for file in [e for e in list_of_main_files if not e.endswith('c') or e.endswith('cpp')  or e.endswith('cc')]:
                        # Move and rename template file
                        temp_file = file.replace('.c.template', '.c')
                        temp_file = os.path.join(output_dir, ntpath.basename(temp_file))
                        shutil.copyfile(file, temp_file)

                        # Replace template file with temp-file in build command
                        list_of_main_files.remove(file)
                        list_of_main_files.append(temp_file)

                    # Add Clang Tidy to build command
                    clang_tidy_com = toolchain.clang_tidy_com
                    if CONST_CORE_CMSE_DICT[project.mcu_dict[current_mcu]]:
                        if 'tz_s' == project.type or 'tz_s_only' == project.type:
                            clang_tidy_com += " -D__ARM_FEATURE_CMSE=3"
                    main_env["CCCOM"] = clang_tidy_com + os.linesep + main_env["CCCOM"]
                    test_env["CCCOM"] = clang_tidy_com + os.linesep + test_env["CCCOM"]
                    no_instrument_env["CCCOM"] = clang_tidy_com + os.linesep + no_instrument_env["CCCOM"]

            # If we need to create a library for this module then we need to create the *.a file and then use
            # it in final linked elf instead of object files for main_dirs
            if project.create_lib:
                # main_objs is empty because we're adding library instead
                main_objs = []
                # Still need to create object files for the library
                lib_objs = main_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_main_files)))
                lib_objs.sort()

                # Build Library
                output_lib_file = os.path.join(output_dir, 'lib' + project.module_name + '.a')
                NoCache(output_lib_file)
                AlwaysBuild(output_lib_file)
                print("Building lib: " + output_lib_file)
                main_libs = main_env.StaticLibrary(output_lib_file, lib_objs)
                # Add newly created library to list of libs to use when creating the ELF
                list_of_libs.append(str(main_libs[0]))
            elif not CONST_ONLY_LIBS:
                main_objs   = main_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_main_files)))

            # If we are building only the module source or libraries, skip building test/common files and linking
            if (project.build_module_source_only) or (CONST_ONLY_LIBS == True) or (project.create_lib):
                main_env.VariantDir(output_dir, '.', duplicate = 0)
                continue

            # object files to build
            #no_instrument_objs      = no_instrument_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_no_instrument_files)))
            common_objs             = common_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_common_files)))
            test_objs               = test_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_test_files)))
            third_party_test_objs   = third_party_test_env.Object(list(map(lambda x: os.path.join(output_dir, x), list_of_third_party_test_files)))

            object_list = (common_objs + test_objs + main_objs + third_party_test_objs )

            # sort list of input files to make output consistent
            object_list.sort()

            # Linker step
            # if objects are passed to linker as arguments than the command will be too long and will fail
            # to solve this problem, objects must be passed in using a file
            link_file = output_dir + '/' + output_file + '.elf.in'
            cmd = []
            if not os.path.exists(output_dir):
                os.makedirs(output_dir)
            with open(link_file, 'w') as f:
                for object in object_list:
                    cmd += str(object) + ' '
                cmd = ''.join(cmd).replace('\\', '/')
                f.write(cmd)

            lib_names = list(map(lambda x: os.path.basename(x).strip('lib').split('.')[0], list_of_libs))
            lib_paths = list(map(lambda x: os.path.dirname(x), list_of_libs))

            # Create environment for linking all the objects together
            exe_env = create_common_env()
            # For AC6, standard lib is required to build C++ projects
            if toolchain.name == "ac6" and "__ARMCC_USING_STANDARDLIB" in project.test_macros:
                exe_env["LINKFLAGS"].remove('--library_type=microlib')
            exe_env.VariantDir(output_dir, '.', duplicate = 0)
            target_file = os.path.join(output_dir, output_file)

            # Remove existing binaries so old artifacts are not tested if the build was not successful
            if os.path.exists(output_elf_file):
                os.remove(output_elf_file)
            if os.path.exists(output_elf_file + '.o'):
                os.remove(output_elf_file + '.o')

            # Add all libraries that were found
            exe_env['LIBS'] += lib_names
            exe_env['LIBPATH'] += lib_paths
            exe_env["LINKFILE"] = link_file

            if project.secondary_linker_includes and 'secondary' in build_config_name:
                exe_env["LIBINCPATH"] = copy.deepcopy(project.secondary_linker_includes)

            print("Building elf:" + output_elf_file)
            exe_env['PROJECT_PATH'] = output_file_path

            # For J-Link, program the srec instead of the .elf file
            # Change output file name to 'srec' in build metadata file
            output_srec_file = output_elf_file[:-len('.elf')] + '.srec'

            # Write YML file that has project details
            if 'ac6' == toolchain.name:
                # Add elf -> srec builder to scons construction environment
                exe_env.Command(output_srec_file, output_elf_file, 'fromelf --m32combined --output=${TARGET} ${SOURCE}')
                build_info['application'] = output_srec_file
            else:
                build_info['application'] = output_srec_file
                # Add elf -> srec builder to scons construction environment
                exe_env.Command(output_srec_file, output_elf_file, 'arm-none-eabi-objcopy ${SOURCE} ${TARGET} -O srec')
            if 'rtt_address_elf' not in build_info:
                build_info['rtt_address_elf'] = output_elf_file

            # To reduce cache size, don't cache .elf files
            NoCache(output_elf_file)
            AlwaysBuild(output_elf_file)

            # In most cases the secure-only project should be skipped.
            # Projects with type = tz_s_only are a special case where the unity test framework executes in the secure project.
            # These project types are not skipped here.
            if 'tz_s' != project.type:
                with open(output_file_path + '.yml', 'w') as f:
                    f.write(yaml.dump(build_info))


            elf_output_key = str(build_config_name + ":debug:" + board + ":" + toolchain.name + ":")
            g_project_list.append((output_elf_file, main_objs, elf_output_key))

            # Link object files together to create executable
            exe_env['CMSE_IMPORT_LIB'] = secure_import_lib
            # if 'TX_ENABLE_IAR_LIBRARY_SUPPORT' in test_env['CPPDEFINES'] and 'iar' == toolchain.name:
                # exe_env['LINKFLAGS'] += toolchain.iar_lib_link_flags
            if (secure_import_elf):
                # Ensure the secure project is built before the non-secure project
                object_list.append(secure_import_elf)

            # Add implicit dependencies to scons environment
            #  - Some projects define include files via the pre-processor. Scons is not good at
            #    finding these, so we add them explicitly here.
            #    NOTE: Currently this makes all build files dependent on the implicit files,
            #          which could be improved later if needed.
            implicit_dependencies = []
            for file in project.implicit_dependencies:
                for path in project.includes:
                    full_path = os.path.join(path,file)
                    if os.path.exists(full_path):
                        implicit_dependencies.append(full_path)
                        print('LOG: Implicit dependency: {}'.format(full_path))
            exe_env.Depends(object_list, implicit_dependencies)

            # Because bsp_override_reg.h is included via a macro, scons will not automatically detect that it is a dependency.
            bsp_override_reg_headers = [os.path.join(d[0], 'bsp_override_reg.h') for d in os.walk('ra/fsp/src/bsp/mcu/') if 'bsp_override_reg.h' in d[2]]
            exe_env.Depends(object_list, bsp_override_reg_headers)

            # Queue build
            exe_env.Program(target = target_file, source = object_list)

    def _parse_toolchains(self, file, toolchains):
        with open(file, 'r') as f:
            xml_toolchains = yaml.load(f, Loader=yaml.Loader)

        self.compiler_list = xml_toolchains.keys()
        for key in self.compiler_list:
            tc = toolchain(xml_toolchains[key])
            toolchains.append(tc)

# Define MCUboot class to store all variables related to MCUboot signing
class mcuboot(object):
    def __init__(self, bootloader_root):
        self.name = bootloader_root.find('name').text
        self.header_size = bootloader_root.find('header_size').text
        self.slot_size = bootloader_root.find('slot_size').text
        self.max_sectors = bootloader_root.find('max_sectors').text
        self.align = bootloader_root.find('align').text
        self.version = bootloader_root.find('version').text
        self.secondary_version = bootloader_root.find('secondary_version').text
        self.primary_slot = bootloader_root.find('primary_slot').text
        self.secondary_slot = bootloader_root.find('secondary_slot').text
        self.primary_pad_arg = bootloader_root.find('primary_pad_arg').text
        self.secondary_pad_arg = bootloader_root.find('secondary_pad_arg').text
        if self.secondary_pad_arg is None:
            self.secondary_pad_arg = ''
        if self.primary_pad_arg is None:
            self.primary_pad_arg = ''


# Define project class to store all variables related to project
class project_common(object):
    def __init__(self, file, xml_root=None, common_file=CONST_COMMON_PROJECT_FILE):
        self.boards = []
        self.bootloader = None
        self.common_dirs = []
        self.common_macros = {}
        self.dependencies = []
        self.exclude_dirs = []
        self.includes = []
        self.key = ''
        self.enc_key = ''
        self.libraries = []
        self.linker_paths = []
        self.linker_includes = []
        self.secondary_linker_includes = []
        self.linker_scripts = []
        self.main_dirs = []
        self.main_macro_configurations = []
        self.name = ''
        self.no_instrument_files = []
        self.skip_compiler = []
        self.srec_check = []
        self.test_dirs = []
        self.test_macros = {}
        self.third_party_test_dirs = []
        self.type = 'flat'
        self.target_group = None
        self.test_info_init = '{}'
        self.custom_cxx_flags = defaultdict(list)

        # Populate a list of primary cores using CONST_MCU_DICT
        self.mcu_dict = {}
        for mcu in CONST_MCU_DICT:
            self.mcu_dict[mcu] = CONST_MCU_DICT[mcu]["primary_core"]

        self.filename = os.path.basename(file)
        self.module_name, _ = os.path.splitext(self.filename)

        # Parse common project information
        if common_file is not None:
            common_tree = etree.parse(common_file)
            common_root = common_tree.getroot()
            parse_project(common_root, self)
        if xml_root is not None:
            parse_project(xml_root, self)

class project_tz_secure(project_common):
    _xml_file = CONST_COMMON_TZ_S_PROJECT_FILE
    def __init__(self, filename, xml_root):
        super().__init__(filename)
        self.type = 'tz_s'
        # Extend common_project type
        extend_tree = etree.parse(self._xml_file)
        extend_root = extend_tree.getroot()
        parse_project(extend_root, self)
        parse_project(xml_root, self)

class project_tz_nonsecure(project_common):
