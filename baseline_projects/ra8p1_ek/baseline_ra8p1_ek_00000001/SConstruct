# Will get this information from tools cfg file if present

def configure_scons_cache(cache_dir):
    # Handle 'None' type input
    cache_dir = str(cache_dir)

    # Check if scons cache is valid directory. SCons will actually create a cache directory for you. I'm
    # not using the path if it does not exist and does not end with 'scons_cache' as I bet that is not
    # intended. If it is intended (eg: creating new cache) then create the directory before calling SCons.
    basename = os.path.basename(os.path.normpath(cache_dir))
    if not os.path.isdir(cache_dir) and 'scons_cache' != basename:
        print('ENV: SCons cache directory {}, does not exist.'.format(cache_dir))
        cache_dir = ''

    if cache_dir != '' and not GetOption('cache_disable'):
        # This is set when creating each environment, but print here to avoid spam
        print("ENV: SCons cache path: " + cache_dir)
    else:
        print("ENV: SCons cache disabled")
        cache_dir = ''
    return cache_dir

def update_global_path():
    if os.path.exists(CONST_TOOLS_CFG_FILE_NAME):
        tools_cfg = CONST_TOOLS_CFG_FILE_NAME
    else:
        tools_cfg = CONST_TOOLS_CFG_REF_FILE_NAME

    # Get the XML tree
    tree = etree.parse(tools_cfg)
    root = tree.getroot()

    # Check if <scons_cache_dir> element is found. If so, record path
    global g_scons_cache_dir
    cache_elem = root.find('scons_cache_dir')
    g_scons_cache_dir = cache_elem.text if cache_elem is not None else ''
    g_scons_cache_dir = configure_scons_cache(g_scons_cache_dir)

    gcc_root = root.find('gcc_install').text
    llvm_root = root.find('llvm_install').text

    gcc_bin_loc = os.path.join(gcc_root, 'bin')
    llvm_bin_loc = os.path.join(llvm_root, 'bin')

    print("ENV: GCC 'bin' folder: " + gcc_bin_loc)
    print("ENV: LLVM 'bin' folder: " + llvm_bin_loc)

    os.environ["PATH"] = gcc_bin_loc + os.pathsep + \
                         llvm_bin_loc + os.pathsep 
    default_env = DefaultEnvironment(tools = [])

def create_env():
    # Create dictionary of environment variables
    env = Environment(CPPDEFPREFIX = '-D',
        OBJSUFFIX = '.o',
        INCPREFIX = '-I',
        LIBDIRPREFIX = '-L',
        PROGSUFFIX = '.elf',
        OPTIMIZATION = '-O0',
        PROJECT_DIR = CONST_PROJECT_XML_DIR,
        tools = ['cxx', 'cc', 'as', 'link', 'ar'],
        )

    if g_scons_cache_dir != '':
        env.CacheDir(g_scons_cache_dir)

    if static_analyze is not None:
        env["CLANG_ISYSTEM_PATH"] = os.environ['CLANG_ISYSTEM_PATH']

    env.PrependENVPath('PATH', os.environ['PATH'])


    return env

def split_macro_list(macro_list):
    # Splits a macro list respecting parentheses so arguments can be used in macros.
    paren_depth = 0
    start_idx = 0
    out_list = []
    for i in range(0,len(macro_list)):
        if macro_list[i] == '(':
            paren_depth += 1
        elif macro_list[i] == ')':
            paren_depth -= 1
        elif (macro_list[i] == ',') and (paren_depth == 0):
            out_list.append(macro_list[start_idx:i])
            start_idx = i + 1
    out_list.append(macro_list[start_idx:])
    return out_list

def parse_xml_path_append(local_list, item):
    local_list.append(item.text)

def parse_xml_path(root, xml_path_list, local_list, function=parse_xml_path_append):
    tag = xml_path_list.pop(0)
    for item in root.findall(tag):
        if len(xml_path_list) > 0:
            parse_xml_path(item, xml_path_list, local_list, function)
        else:
            function(local_list, item)

def parse_xml_path_dict(local_list, item):
    try:
        list = item.text.split('=')
    except:
        list = item.split('=')
    if len(list) > 1:
        value = list[1]
    else:
        value = '1'
    local_list[list[0]] = value
    return local_list

def parse_xml_path_limits(local_list, item):
    # Store source directory and board limits in an array
    attr = item.get("exclude_boards")
    exclude_boards = None
    if attr is not None:
        exclude_boards = attr.split(',')
        exclude_boards = [board.strip() for board in exclude_boards]
    local_list.append([item.text, exclude_boards])

def parse_project(root, project):
    project.build_module_source_only = False
    if len(root.findall("module_src_only")) > 0:
        if 'true' == root.find("module_src_only").text:
            project.build_module_source_only = True

    project.name = ''
    if len(root.findall("name")) > 0:
        project.name = root.find("name").text

    if len(root.findall("key")) > 0:
        project.key = root.find("key").text

    if len(root.findall("enc_key")) > 0:
        project.enc_key = root.find("enc_key").text

    # See if we should create a library for this module. Default is False.
    project.create_lib = False
    if len(root.findall("create_lib")) > 0:
        if "true" == root.find("create_lib").text.lower():
            project.create_lib = True

    # Parse include directories into the provided list
    xml_path_list = ['include_dirs', 'include']
    parse_xml_path(root, xml_path_list, project.includes)

    # Parse source directories into the provided list
    xml_path_list = ['main_dirs', 'src']
    parse_xml_path(root, xml_path_list, project.main_dirs, parse_xml_path_limits)

    # Check if we should ignore warnings on main_dirs code. This should only be used
    # in exceptional circumstances. For example, if we do not own the code and cannot
    # change it.
    project.ignore_warnings = False
    if root.find('main_dirs') is not None:
        if 'ignore_warnings' in root.find('main_dirs').attrib:
            if root.find('main_dirs').attrib['ignore_warnings'] == 'true':
                project.ignore_warnings = True

    # For libraries we only need main_dirs code and ignore test macros
    if not project.create_lib:
        xml_path_list = ['common_dirs', 'src']
        parse_xml_path(root, xml_path_list, project.common_dirs, parse_xml_path_limits)
        project.implicit_dependencies = [re.findall('[a-zA-Z0-9_]+\.h',e)[0] for e in project.test_macros.values() if '.h\\"' in e]

    xml_path_list = ['no_instrument_files', 'src']
    parse_xml_path(root, xml_path_list, project.no_instrument_files)

    xml_path_list = ['exclude_dirs', 'exclude']
    parse_xml_path(root, xml_path_list, project.exclude_dirs)
    project.exclude_dirs = [os.path.normpath(x) for x in project.exclude_dirs]

    # Parse macros into the provided dictionary
    xml_path_list = ['common_macros', 'macro']
    parse_xml_path(root, xml_path_list, project.common_macros, parse_xml_path_dict)

    # parse macro configurations
    options_list = []
    for main_macro_configuration in root.findall('main_macro_configurations/main_macro_configuration'):
        options = []
        # options_list will be [] the first time through this loop so the else will be hit
        for macro in main_macro_configuration.findall('macro'):
            options.append((macro.get('name'), split_macro_list(macro.text)))
        # If options_list is not empty then we need to combine the multiple main_macro_configuration elements
        if options_list:
            options_list = list(itertools.product(options_list, options))
            merged_options_list = []
            for option1, option2 in options_list:
                name1, macros1 = option1
                name2, macros2 = option2
                if name1 and name2:
                    merged_name = name1 + '_' + name2
                else:
                    merged_name = name1 + name2
                merged_options_list.append((merged_name, macros1 + macros2))
                options_list = merged_options_list
        else:
            options_list = options

    options_dict = {}
    for key, macros in options_list:
        # Check for 'typical' build
        if key == "":
            key = 'typical'
        macro_dict = {}
        for macro in macros:
            parse_xml_path_dict(macro_dict, macro)
        options_dict[key] = macro_dict
    if not options_dict:
        options_dict['typical'] = {}
    project.main_macro_configurations = options_dict

    # Check to see if any framework layer modules are used.  If so, define macros appropriately
    project.common_macros['BSP_CFG_RTOS'] = '0'
    for src in project.third_party_test_dirs:
        # Allow testing of frameworks without ThreadX
        if os.path.relpath('threadx') in os.path.relpath(src[0]):
            project.common_macros['BSP_CFG_RTOS'] = '1'
            break
        # Allow testing of frameworks without FreeRTOS
        if os.path.relpath('FreeRTOS') in os.path.relpath(src[0]):
            project.common_macros['BSP_CFG_RTOS'] = '2'
            break

    # Parse linker scripts
    linker_scripts_local = []
    xml_path_list = ['linker_scripts', 'script']
    parse_xml_path(root, xml_path_list, linker_scripts_local)
    if len(linker_scripts_local) > 0:
        project.linker_scripts = linker_scripts_local

    # Parse linker paths
    xml_path_list = ['linker_paths', 'path']
    parse_xml_path(root, xml_path_list, project.linker_paths)

    # Parse linker includes
    linker_includes_local = []
    xml_path_list = ['linker_includes', 'path']
    parse_xml_path(root, xml_path_list, linker_includes_local)
    if len(linker_includes_local) > 0:
        project.linker_includes = linker_includes_local

    # Parse secondary linker includes (bootloader XIP app)
    secondary_linker_includes_local = []
    xml_path_list = ['secondary_linker_includes', 'path']
    parse_xml_path(root, xml_path_list, secondary_linker_includes_local)
    if len(secondary_linker_includes_local) > 0:
        project.secondary_linker_includes = secondary_linker_includes_local

    # Parse libraries
    xml_path_list = ['libraries', 'library']
    parse_xml_path(root, xml_path_list, project.libraries)

    # Parse objects
    xml_path_list = ['dependencies', 'dependency']
    parse_xml_path(root, xml_path_list, project.dependencies)

    # Parse board names
    xml_path_list = ['boards', 'board']
    parse_xml_path(root, xml_path_list, project.boards)

    # Parse compilers to skip
    xml_path_list = ['skip_compiler', 'compiler']
    parse_xml_path(root, xml_path_list, project.skip_compiler)

    custom_cxx_flags_element = root.find('custom_cxx_flags')
    if None != custom_cxx_flags_element:
        # Comments are included as children of lxml elements. Filter out comments by checking the type.
        compiler_elements = filter(lambda x: type(x) == etree._Element, list(custom_cxx_flags_element))

        # Get the tag name from each compiler
        compilers = list(map(lambda x: x.tag, compiler_elements))

        # Iterate over compilers to get custom cxx flags
        for compiler in compilers:
            xml_path_list = [ 'custom_cxx_flags', compiler, 'flag' ]
            cxx_flags = []
            parse_xml_path(root, xml_path_list, cxx_flags)
            project.custom_cxx_flags[compiler] = cxx_flags

def configure_tool_environment(env, toolchain, mcu, project, third_party=False):
    env["CC"] = toolchain.cc_name
    env["CXX"] = toolchain.cc_name
    env["AS"] = toolchain.as_name
    env["LINK"] = toolchain.link_name
    env["AR"] = toolchain.ar_name
    env["CCCOM"] = toolchain.cc_com
    env["CXXCOM"] = toolchain.cpp_com
    env["ASCOM"] = toolchain.as_com
    env["LINKCOM"] = toolchain.link_com
    env["ARCOM"] = toolchain.ar_com
    env["_LINKSCRIPTS"] = '$( ${_concat(LINKSCRIPTPREFIX, LINKSCRIPTS, LINKEXT, __env__, RDirs, TARGET, SOURCE)} $)'
    env["_LIBINCFLAGS"] = '$( ${_concat(LIBINCPREFIX, LIBINCPATH, LIBINCSUFFIX, __env__, RDirs, TARGET, SOURCE)} $)'
    env["LIBLINKPREFIX"] = toolchain.lib_prefix
    env["LIBDIRPREFIX"] = toolchain.lib_dir_prefix
    env["LIBINCPREFIX"] = toolchain.lib_inc_prefix
    env["LIBINCSUFFIX"] = toolchain.lib_inc_suffix
    env["LIBLINKSUFFIX"] = ''
    env["CXXFILESUFFIX"] = '.cpp'

    cxx_flags = copy.deepcopy(toolchain.cxx_flags)

    # FSP and Third Party flags apply to c and c++
    if third_party or project.ignore_warnings:
        cxx_flags += toolchain.third_party_flags
    else:
        cxx_flags += toolchain.fsp_flags

    if CONST_CORE_FPU_DICT[project.mcu_dict[mcu]]:
        # Linker flags apply to C and C++. Dont put flags in common_flags because some linkers do not have FPU flags
        cxx_flags = copy.deepcopy(toolchain.fpu_flags) + cxx_flags
        env["LINKFLAGS"] = copy.deepcopy(toolchain.link_flags) + toolchain.fpu_link_flags
        env["FPU_VERSION"] = CONST_CORE_FPU_DICT[project.mcu_dict[mcu]]
    else:
        env["LINKFLAGS"] = copy.deepcopy(toolchain.link_flags)

    if CONST_CORE_CMSE_DICT[project.mcu_dict[mcu]]:
        if 'tz_s' == project.type or 'tz_s_only' == project.type:
            cxx_flags += toolchain.cmse_flags
            env["LINKFLAGS"] += toolchain.cmse_link_flags

    # If creating lib, do not add debug flags as that will greatly increase size of library
    if not project.create_lib and not project.build_module_source_only:
        cxx_flags += toolchain.debug_flags

    env['CXX_FLAGS'] = cxx_flags + project.custom_cxx_flags[toolchain.name]
    env['C_FLAGS'] = toolchain.c_flags
    env['CPP_FLAGS'] = toolchain.cpp_flags
    env["COMMON_FLAGS"] = toolchain.common_flags

    env["ASFLAGS"] = toolchain.as_flags
    env["COMPILER"] = toolchain.name
    env["LINKEXT"] = toolchain.link_ext
    env["LINKSCRIPTPREFIX"] = toolchain.link_script_prefix

def configure_build_rules(env):
    # Get global builder and set rule for '.c.template' files to be identical to that of '.c' files
    import SCons.Tool
    import SCons.Defaults
    my_suffix = '.c.template'
    static_obj, shared_obj = SCons.Tool.createObjBuilders(env)
    static_obj.add_action(my_suffix, SCons.Defaults.CAction)
    static_obj.add_emitter(my_suffix, SCons.Defaults.StaticObjectEmitter)

def configure_project_environment(env, project):
    # Setup project specific environment variables
    env["LINKSCRIPTS"] = project.linker_scripts
    env["LIBS"] = copy.deepcopy(project.libraries)
    env["LIBPATH"] = copy.deepcopy(project.linker_paths)
    env["LIBINCPATH"] = copy.deepcopy(project.linker_includes)

    # Add include paths
    env["CPPPATH"] = project.includes

def configure_build_environment(env, o_level, toolchain, project, board):

    # Setup project specific environment variables
    try:
        level = toolchain.optimization_levels[o_level]
        if OPTIMIZATION_OVERRIDE is not None:
            level = toolchain.optimization_levels[OPTIMIZATION_OVERRIDE]
    except:
        print("ERROR: Optimization level " + o_level + " not found in " + toolchain.name + " compiler.")
        level = toolchain.optimization_levels['none']

    mcu = board.split('_')[0].lower()
    env["MCU"] = mcu
    core = project.mcu_dict[mcu]
    env["CORE"] = core
    # If project.type is flat then we use linker files in the base of the folder. This is because when we started
    # there was only 'flat' and it was assumed.
    if 'flat' != project.type:
        env["PROJECT_TYPE"] = project.type
    else:
        env["PROJECT_TYPE"] = ""
    # CONST_CORE_ARM_GCC_85_HACKS_DICT is used here because our clang-tidy version is old enough that it does not know about CM85. So we need to trick it to be CM33
    env['CLANG_TIDY_CORE'] = core if (toolchain.name != 'gcc') or (project.mcu_dict[mcu] != '85') else CONST_CORE_ARM_GCC_85_HACKS_DICT['primary_core']

    macros = {}
    macros.update(project.common_macros)
    macros.update({k: v for k, v in [e.split('=') for e in CONST_MCU_DICT[mcu]['macros']]})

    # Add board flag
    board_macro = board + '_BUILD'
    macros[board_macro] = '1'
    # Only apply for RA MCUs and don't override if already provided.
    if mcu.startswith('ra'):
        macros.setdefault('_RENESAS_RA_', None)   # -> -D_RENESAS_RA_
        macros.setdefault('_RA_CORE', 'CPU0')     # -> -D_RA_CORE=CPU0
        macros.setdefault('_RA_ORDINAL', 1)       # -> -D_RA_ORDINAL=1
        macros.setdefault('ETHOSU55', None)       # -> -ETHOSU55
        macros.setdefault('ETHOSU_ARCH', 'u55')   # -> -ETHOSU55
        #macros.setdefault("BSP_BOARD", "ra8p1_ek")
        
    # Used in tools.yml for clang_tidy and llvm
    env["ARM_ARCH"] = CONST_CORE_ARM_ARCH_DICT[project.mcu_dict[mcu]]
    # Passed in as common flags from tools.yml
    env["ARM_ARCH_FLAGS"] = CONST_CORE_ARM_ARCH_FLAGS_DICT[project.mcu_dict[mcu]]
    env["CORE_UPPER"] = core.upper()
    env["CORE_SYMBOL"] = core.replace('plus', '+')
    env["CPPDEFINES"] = macros
    env["OPTIMIZATION"] = level

    # AC6 imposes arbitrary restrictions on uninitialized data sections, requiring them to start with .bss
    if 'ac6' == toolchain.name:
        for key in macros:
            if '.fsp_dtc_vector_table' in macros[key]:
                macros[key] = macros[key].replace('.fsp_dtc_vector_table', '.bss.fsp_dtc_vector_table')
            if '.noinit' in macros[key]:
                macros[key] = macros[key].replace('.noinit', '.bss.noinit')
    return macros

# Prints variables for debugging - comment out for release
def print_env(env):
    for item in sorted(env.Dictionary().items()):
        print("construction variable = '%s', value = '%s'" % item)


######## Program begins here ########
if not GetOption('help'):
    update_global_path()

    # Build a specific project
    projects_to_build = re.split(",| ", global_build_dir)
    if not global_build_dir:
        projects_to_build = [CONST_PROJECT_XML_DIR]
    print(projects_to_build)

    # Create build Object (gathers toolchains and asst. build info)
    build = build_obj(CONST_COMMON_TOOLS_FILE)
    for e in projects_to_build:
        build.add_project(e)
    build.do_builds()

def get_code_size(main_obj_path, cmd_out, parsed_code_sizes, idx):
    out = 0
    code_sizes = {}
    if os.path.exists(main_obj_path):
        out = check_output(['arm-none-eabi-size', '--format=berkeley', main_obj_path])

        if(CONST_FUNCTION_SIZE):
            f = open(main_obj_path+'.code_size', "w")
            objdump = check_output(['arm-none-eabi-objdump', '-t', main_obj_path])
            f.write(objdump)
            f.close()

            parse_code_size(main_obj_path+'.code_size', code_sizes)
    cmd_out[idx] = out
    parsed_code_sizes[idx] = code_sizes

def exit_func():
    # Store the rtt address for each application in test_info.yml. This will be used by fsp_test_parallel.py in order to
    # determine the address of the RTT control block.
    for root,  subdirs, files in os.walk('build/'):
        if 'test_info.yml' in files:
            yaml_file = os.path.join(root, 'test_info.yml')

            # Load the yml file into a dictionary
            with open(yaml_file) as f:
                yml_dict = yaml.load(f, Loader=yaml.SafeLoader)

            # Loop through the yml file and for each application, get the rtt address.
            for target_group in yml_dict:
                for build_config in yml_dict[target_group]:
                    for project in yml_dict[target_group][build_config]['projects']:

                        # For dual-core target_groups add secondary core image as a dependency
                        if 'core' in project.keys():
                            if '0' == project['core']:
                                # Find secondary core image path and add as dependency
                                for secondary_project in yml_dict[target_group][build_config]['projects']:
                                    if '1' == secondary_project['core']:
                                        project['dependencies'].append(secondary_project['application'])

                        # store_symbol_address is an array of symbols that will be search for in the elf.
                        # If the symbol is found in the elf, its address will be stored in test_info.yml.
                        # These symbol addresses can be used by test scripts.
                        # Ex:
                        # The rm_mcuboot_port tests specify 'g_pub_key' which is needed to program MCUboot apps.
                        # 'g_pub_key': <address> is stored in test_info.yml for use by the MCUboot flashing scripts.
                        if 'store_symbol_address' in project:
                            application_elf = project['application']
                            application_elf = application_elf.replace('.srec', '.elf')

                            # Execute readelf command to get the address of project['store_symbol_address']
                            command_output = str(check_output(['arm-none-eabi-readelf', '-s', application_elf]))

                            symbol_addresses = {}
                            for symbol in project['store_symbol_address']:

                                # Filter the output to lines that include 'project.store_symbol_address'
                                command_output_filtered = '\n'.join(list(filter(lambda x: symbol in x, command_output.split('\\n'))))

                                # Example output for readelf command:
                                #
                                # 573: 00000080   128 OBJECT  GLOBAL DEFAULT    1 symbol
                                result = re.search(r'.+: +(.+) +.+ +OBJECT +GLOBAL +.+ +.+ +{symbol_name}$'.format(symbol_name=symbol), command_output_filtered, flags=re.M)
                                if None != result:
                                    symbol_address = result.group(1).strip()

                                    # Save the symbol:address
                                    project[symbol] = symbol_address

                            # The symbol:address pairs are stored to the test_info.yml. The list of symbols to store can be deleted.
                            del project['store_symbol_address']

                        # Get the RTT block address u[sing arm-none-eabi-nm
                        output = check_output(['arm-none-eabi-nm',  '-s', project['rtt_address_elf']])
                        for line in output.decode().split('\n'):
                            if ' _SEGGER_RTT' in line:
                                rtt_address = line.split(' ')[0]
                                project['rtt_address'] = rtt_address

            # Write the results back to the yml file.
            with open(yaml_file, 'wb') as f:
                f.write(yaml.safe_dump(yml_dict, encoding='utf-8', allow_unicode=True))

    print("Code Size Calculation")

    code_sizes = []
    cmd_out = []
    idx = 0
    print_idx = 0

    for elf_file, main_objs, _ in sorted(g_project_list):
        build_output_folder, _ = os.path.split(elf_file)
        for main_obj in sorted(main_objs):
            main_obj_path = str(main_obj)
            # Maintain configured number of threads
            while(threading.active_count() > GetOption('num_jobs')):
                pass
            cmd_out.append(0)
            code_sizes.append(0)
            thread = threading.Thread(target=get_code_size, args=(main_obj_path, cmd_out, code_sizes, idx))
            thread.start()
            idx = idx + 1

        # Print output as threads finish
        if len(cmd_out) > print_idx and cmd_out[print_idx] != 0:
            if 0 == print_idx:
                # Print Heading
                print(cmd_out[0].splitlines()[0].decode() + " build name")
            print(cmd_out[print_idx].splitlines()[1].decode())
            print_idx = print_idx + 1

    # Wait for all threads to complete
    while(threading.active_count() > 1):
        pass

    while(print_idx < len(cmd_out)):
        try:
            print(cmd_out[print_idx].splitlines()[1].decode())
        except:
            print("Error - Missing build artifact")
        print_idx = print_idx + 1

    if(CONST_FUNCTION_SIZE):
      sizes = {}
      builds = []
      for full_build, functions in code_sizes.items():
        build = full_build.split('/')[-2].strip('build_').rstrip('_debug') + '_' + full_build.split('/')[-3]
        builds.append(build)
        for function, size in functions.items():
          if function.split('.')[-1] not in sizes:
            sizes[function.split('.')[-1]] = {}
          sizes[function.split('.')[-1]][build] = size
      for function, configs in sorted(sizes.items(), key=operator.itemgetter(0)):
        print(function)
        for config, size in sorted(configs.items(), key=operator.itemgetter(0)):
          print('\t%s:\t\t%s'%(config, size))

    # Check for elf output files
    print(" ")
    for elf_file, _, statement in g_project_list:
        elf_output_string = "***   The build " + statement + " "
        while len(elf_output_string) <= 80:
            elf_output_string += " "
        if os.path.isfile(elf_file):
            elf_output_string += "SUCCEEDED"
        else:
            elf_output_string += "FAILED"
        print(elf_output_string)

if not GetOption('clean') and not GetOption('help'):
    atexit.register(exit_func)
